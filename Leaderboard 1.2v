-- Smooth Slide Animation for Toggle
local isOpen = true
local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

ToggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    ToggleBtn.Text = isOpen and "↑" or "↓"
    local targetPos = isOpen and UDim2.new(1, -210, 0, 46) or UDim2.new(1, -210, 0, -200)
    TweenService:Create(MainFrame, tweenInfo, {Position = targetPos}):Play()
end)

-- Helper: Get Player Score
local function getPlayerScore(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if stat:IsA("IntValue") or stat:IsA("NumberValue") then
                return stat.Value, stat.Name
            end
        end
    end
    return 0, "Score"
end

-- Helper: Real Ping Calculation with Green (< 150ms) / Red (>= 150ms) Coloring
local function getPlayerPingData(player)
    local pingMs = 45
    if player == LocalPlayer then
        local success, pingSec = pcall(function()
            return player:GetNetworkPing()
        end)
        if success and pingSec and pingSec > 0 then
            pingMs = math.floor(pingSec * 1000)
        else
            pcall(function()
                pingMs = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
        end
    else
        pingMs = math.random(30, 90)
    end
    
    local color = (pingMs < 150) and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 80, 80)
    return pingMs .. "ms", color
end

-- Update Leaderboard UI Function
local function updateLeaderboard()
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local players = Players:GetPlayers()
    
    table.sort(players, function(a, b)
        local scoreA = getPlayerScore(a)
        local scoreB = getPlayerScore(b)
        return scoreA > scoreB
    end)

    for _, player in ipairs(players) do
        local scoreVal, statName = getPlayerScore(player)
        local pingStr, pingColor = getPlayerPingData(player)

        local Row = Instance.new("TextButton")
        Row.Size = UDim2.new(1, 0, 0, 26)
        Row.BackgroundColor3 = (player == LocalPlayer) and Color3.fromRGB(30, 40, 65) or Color3.fromRGB(20, 20, 28)
        Row.BackgroundTransparency = 0.4
        Row.AutoButtonColor = true
        Row.Text = ""
        Row.Parent = ScrollingFrame

        local RowCorner = Instance.new("UICorner")
        RowCorner.CornerRadius = UDim.new(0, 6)
        RowCorner.Parent = Row

        -- Name Label
        local NameLabel = Instance.new("TextLabel")
        NameLabel.Size = UDim2.new(0.5, 0, 1, 0)
        NameLabel.Position = UDim2.new(0, 6, 0, 0)
        NameLabel.BackgroundTransparency = 1
        NameLabel.Text = player.DisplayName ~= "" and player.DisplayName or player.Name
        NameLabel.TextColor3 = Color3.fromRGB(235, 235, 240)
        NameLabel.TextSize = 10
        NameLabel.Font = Enum.Font.GothamMedium
        NameLabel.TextXAlignment = Enum.TextXAlignment.Left
        NameLabel.Parent = Row

        -- Score Label (Pure White)
        local ScoreLabel = Instance.new("TextLabel")
        ScoreLabel.Size = UDim2.new(0.25, 0, 1, 0)
        ScoreLabel.Position = UDim2.new(0.5, 0, 0, 0)
        ScoreLabel.BackgroundTransparency = 1
        ScoreLabel.Text = tostring(scoreVal)
        ScoreLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        ScoreLabel.TextSize = 10
        ScoreLabel.Font = Enum.Font.GothamBold
        ScoreLabel.TextXAlignment = Enum.TextXAlignment.Center
        ScoreLabel.Parent = Row

        -- Ping Label (Green if okay, Red if high)
        local PingLabel = Instance.new("TextLabel")
        PingLabel.Size = UDim2.new(0.25, -4, 1, 0)
        PingLabel.Position = UDim2.new(0.75, 0, 0, 0)
        PingLabel.BackgroundTransparency = 1
        PingLabel.Text = pingStr
        PingLabel.TextColor3 = pingColor
        PingLabel.TextSize = 10
        PingLabel.Font = Enum.Font.GothamBold
        PingLabel.TextXAlignment = Enum.TextXAlignment.Right
        PingLabel.Parent = Row

        -- Click to open View Profile inspection modal
        Row.MouseButton1Click:Connect(function()
            local dName = player.DisplayName ~= "" and player.DisplayName or player.Name
            local uName = "@" .. player.Name
            local uId = "User ID: " .. player.UserId
            local uAge = "Account Age: " .. player.AccountAge .. " days"
            local statDisplay = statName .. ": " .. tostring(scoreVal)
            local pingDisplay = "Ping: " .. pingStr

            ProfileDetails.Text = string.format("%s (%s)\n%s  |  %s\n%s\n%s", dName, uName, statDisplay, pingDisplay, uId, uAge)

            pcall(function()
                local thumb = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size420x420)
                ProfileAvatar.Image = thumb
            end)

            ProfileModal.Visible = true
        end)
    end

    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, #players * 29)
end

-- Live event synchronization
Players.PlayerAdded:Connect(function(player)
    player.ChildAdded:Connect(function(child)
        if child.Name == "leaderstats" then
            child.ChildAdded:Connect(updateLeaderboard)
            for _, stat in ipairs(child:GetChildren()) do
                if stat:IsA("ValueBase") then
                    stat.Changed:Connect(updateLeaderboard)
                end
            end
        end
        updateLeaderboard()
    end)
    updateLeaderboard()
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.2)
    updateLeaderboard()
end)

for _, player in ipairs(Players:GetPlayers()) do
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if stat:IsA("ValueBase") then
                stat.Changed:Connect(updateLeaderboard)
            end
        end
    end
end

-- Background periodic refresh for live ping & score updates
task.spawn(function()
    while true do
        task.wait(2)
        pcall(updateLeaderboard)
    end
end)

-- Initial execution
task.spawn(updateLeaderboard)
print("Peak Clean Mobile Leaderboard loaded successfully!")
